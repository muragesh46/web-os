# Gemini AI key for backend AI assistant (MAI)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Connection String (e.g., from MongoDB Atlas or local mongodb://localhost:27017/webos)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/webos?appName=Cluster0

# Secret Key for JSON Web Tokens (JWT) used in authentication (use a random 64-char string)
JWT_SECRET=your_jwt_secret_key_here

# Frontend API URL (leave blank for production or http://localhost:3001/api for local dev)
VITE_API_URL=http://localhost:3001/api

